{
  "name": "arshield",
  "version": "0.3.1",
  "private": true,
  "description": "ArShield — post-quantum security infrastructure. Web app + MCP server (ML-KEM-768 + X25519, ML-DSA-65).",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "node scripts/build-worker.mjs",
    "prebuild": "node scripts/build-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "mcp:build": "npm --prefix packages/core run build && npm --prefix packages/mcp run build",
    "mcp:interop": "node scripts/interop-test.mjs",
    "mcp:recipient": "node scripts/recipient-e2e.mjs",
    "wallet:e2e": "node scripts/wallet-e2e.mjs",
    "test": "npm run check && npm run mcp:interop && npm run mcp:recipient && npm run wallet:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@noble/post-quantum": "^0.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
